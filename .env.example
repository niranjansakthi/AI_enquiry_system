# ── Groq AI ──────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=30
GROQ_MAX_RETRIES=2

# ── Database ──────────────────────────────────────────────────────────────
# PostgreSQL (recommended for production)
DATABASE_URL=YOUR_PGADMIN_DB
# SQLite (local development fallback)
# DATABASE_URL=sqlite:///./enquiries.db

# ── Application ───────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
